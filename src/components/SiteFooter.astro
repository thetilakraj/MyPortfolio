---
const year = new Date().getFullYear();

const elsewhere = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/thetilakraj/' },
  { label: 'GitHub', href: 'https://github.com/thetilakraj' },
];
---

<footer class="mt-28 border-t border-rule">
  <div class="mx-auto max-w-5xl px-6 py-10">
    <div class="flex flex-wrap items-start justify-between gap-x-10 gap-y-6">
      <div>
        <p class="label mb-2">Get in touch</p>
        <p class="m-0">
          <a
            href="mailto:thetilakraj@gmail.com"
            class="text-ink no-underline hover:text-signal">thetilakraj@gmail.com</a
          >
        </p>
      </div>

      <div>
        <p class="label mb-2">Elsewhere</p>
        <ul class="flex list-none gap-6 p-0">
          {
            elsewhere.map((l) => (
              <li>
                <a
                  href={l.href}
                  target="_blank"
                  rel="noopener"
                  class="text-ink no-underline hover:text-signal"
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="label mt-10">&copy; {year} Tilak Raj</p>
  </div>
</footer>
