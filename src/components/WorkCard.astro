---
import { url } from '../lib/url';

interface Props {
  id: string;
  title: string;
  summary: string;
  pillar: 'products' | 'enterprise' | 'research';
  status: string;
  employer?: string;
  vehicle?: string;
  stack?: string[];
}

const { id, title, summary, pillar, status, employer, vehicle, stack = [] } =
  Astro.props;

const pillarLabel = {
  products: 'Product',
  enterprise: 'Enterprise',
  research: 'Research',
}[pillar];

const statusLabel = {
  live: 'Live',
  'in-development': 'In development',
  'in-progress': 'In progress',
  delivered: 'Delivered',
  archived: 'Archived',
}[status] ?? status;

const attribution = vehicle ?? employer;
---

<article class="border-b border-rule py-8 last:border-b-0">
  <div
    class="mb-2 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs uppercase tracking-widest text-ink-faint"
  >
    <span>{pillarLabel}</span>
    <span aria-hidden="true">/</span>
    <span class="text-signal">{statusLabel}</span>
    {attribution && <><span aria-hidden="true">/</span><span>{attribution}</span></>}
  </div>

  <h2 class="mb-2 font-serif text-2xl font-medium tracking-tight">
    <a href={url(`/work/${id}`)} class="no-underline hover:text-signal">
      {title}
    </a>
  </h2>

  <p class="mb-3 max-w-prose text-ink-soft">{summary}</p>

  {
    stack.length > 0 && (
      <ul class="flex list-none flex-wrap gap-2 p-0 font-mono text-xs text-ink-faint">
        {stack.map((s) => (
          <li class="rounded bg-surface-2 px-2 py-1">{s}</li>
        ))}
      </ul>
    )
  }
</article>
