---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkRow from '../components/WorkRow.astro';
import { url } from '../lib/url';

const featured = (await getCollection('work'))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Tilak Raj — SAP BTP Lead Consultant & Product Designer"
  description="Ten years designing and building software inside hard constraints — enterprise SAP delivery by day, independent consumer products by night."
>
  <!-- The claim. Left-aligned, no photo, no centred hero. -->
  <section class="pt-6 pb-20 sm:pt-14">
    <h1 class="display max-w-[19ch] text-[2.6rem] sm:text-[3.5rem]">
      Ten years shipping software inside hard constraints.
    </h1>
    <p class="lede mt-6 max-w-[46ch]">
      First someone else's. Now also my own.
    </p>
  </section>

  <!-- The two pillars, expressed structurally as two columns. -->
  <section class="grid gap-x-12 gap-y-10 border-t border-rule pt-10 sm:grid-cols-2">
    <div>
      <p class="label mb-3">By day</p>
      <p class="max-w-[38ch] text-ink">
        I lead the technical delivery of an enterprise SAP BTP platform toward
        production launch, across multiple vendor teams — readiness, code
        review, QA strategy, and the launch itself.
      </p>
      <p class="mt-3 text-sm text-ink-soft">
        Technical Lead, Chicken Farmers of Ontario
      </p>
    </div>

    <div>
      <p class="label mb-3">Nights and weekends</p>
      <p class="max-w-[38ch] text-ink">
        I design, build, and ship consumer products end to end — research,
        design system, engineering, billing, release. No handoffs, because
        there's no one to hand off to.
      </p>
      <p class="mt-3 text-sm text-ink-soft">TritSync Incorp Inc.</p>
    </div>
  </section>

  <section class="mt-14 border-t border-rule pt-4">
    <p class="max-w-[58ch] text-ink-soft">
      The discipline is the same on both sides. Enterprise work hands you a
      design language, hard business rules, and no permission to freelance. I
      spent a decade delivering inside that — then wrote stricter constraints
      for myself when nobody was making me.
    </p>
  </section>

  <!-- Selected work as an index, not a card grid. -->
  <section class="mt-24">
    <h2 class="label mb-2">Selected work</h2>
    {featured.map((entry) => <WorkRow id={entry.id} {...entry.data} />)}
    <p class="mt-8 border-t border-rule pt-6">
      <a href={url('/work')} class="text-signal no-underline hover:underline"
        >All work &rarr;</a
      >
    </p>
  </section>
</BaseLayout>
