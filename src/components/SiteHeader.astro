---
import { url, isCurrent } from '../lib/url';

const pathname = Astro.url.pathname;

const links = [
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
];
---

<header class="border-b border-rule">
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-baseline justify-between gap-x-8 gap-y-3 px-6 py-5"
  >
    <a href={url('/')} class="group no-underline">
      <span class="font-serif text-[1.0625rem] font-medium tracking-tight"
        >Tilak Raj</span
      >
      <span class="label ml-3 hidden sm:inline">Toronto</span>
    </a>

    <nav aria-label="Primary">
      <ul class="flex list-none items-baseline gap-7 p-0 text-sm">
        {
          links.map(({ href, label }) => {
            const current = isCurrent(href, pathname);
            return (
              <li>
                <a
                  href={url(href)}
                  aria-current={current ? 'page' : undefined}
                  class:list={[
                    'no-underline transition-colors hover:text-signal',
                    current ? 'text-signal' : 'text-ink-soft',
                  ]}
                >
                  {label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
